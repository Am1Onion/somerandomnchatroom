# Firebase CLI local state / logs
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.runtimeconfig.json

# Actual secrets - if you ever add Cloud Functions or the Admin SDK,
# THESE are the files that must never be committed (unlike firebase-config.js,
# which only holds the public web client config).
serviceAccountKey.json
service-account*.json
*.pem
.env
.env.*

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# If you ever add Node tooling later
node_modules/
